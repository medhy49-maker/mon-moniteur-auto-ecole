// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SCHOOL_ADMIN
  INSTRUCTOR
  STUDENT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(STUDENT)
  status        UserStatus     @default(PENDING)
  lastLoginAt   DateTime?

  instructor    Instructor?
  student       Student?
  refreshTokens RefreshToken[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model RefreshToken {
  id            String        @id @default(uuid())
  tokenHash     String        @unique
  familyId      String
  expiresAt     DateTime
  revokedAt     DateTime?
  userAgent     String?       @db.Text
  ipAddress     String?       @db.VarChar(45)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentTokenId String?
  parentToken   RefreshToken? @relation("RefreshTokenRotation", fields: [parentTokenId], references: [id], onDelete: SetNull)
  rotatedTokens RefreshToken[] @relation("RefreshTokenRotation")

  createdAt     DateTime      @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Instructors
model Instructor {
  id               String    @id @default(uuid())
  firstName        String    @db.VarChar(100)
  lastName         String    @db.VarChar(100)
  email            String    @unique
  phone            String
  licenseNumber    String    @unique @db.VarChar(20)
  status           String    @default("active") // active, inactive, suspended
  biography        String?   @db.Text
  profilePicture   String?   @db.Text
  userId           String?   @unique
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  lessons          Lesson[]
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("instructors")
}

// Students
model Student {
  id               String    @id @default(uuid())
  firstName        String    @db.VarChar(100)
  lastName         String    @db.VarChar(100)
  email            String    @unique
  phone            String
  dateOfBirth      DateTime
  licenseNumber    String    @unique @db.VarChar(20)
  level            String    @default("beginner") // beginner, intermediate, advanced, completed
  status           String    @default("active") // active, inactive, suspended
  profilePicture   String?   @db.Text
  hoursCompleted   Int       @default(0)
  userId           String?   @unique
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  lessons          Lesson[]
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("students")
}

// Lessons
model Lesson {
  id               String    @id @default(uuid())
  title            String    @db.VarChar(255)
  description      String?   @db.Text
  scheduledAt      DateTime
  startedAt        DateTime?
  endedAt          DateTime?
  duration         Int       @default(0) // in minutes
  type             String    // theory, practice, exam
  status           String    @default("scheduled") // scheduled, in_progress, completed, cancelled
  rating           Int?      // 1-5 stars
  feedback         String?   @db.Text
  location         String?   @db.VarChar(100)
  
  instructorId     String
  instructor       Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("lessons")
}
